# 复制为 .env 后填写，.env 不要提交到 git
# 全部配置项请以 app/config.py 的 Settings 为准，此处仅列模板

# ---------- 模型 API Key ----------
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
TAVILY_API_KEY=

# ---------- 远程服务器（可选） ----------
REMOTE_HOST=
REMOTE_USER=root

# ---------- PostgreSQL ----------
PG_HOST=localhost
PG_PORT=5432
PG_DB=datapilot_app
PG_USER=datapilot
PG_PASSWORD=

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- MinIO ----------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=datapilot

# ---------- Qdrant ----------
QDRANT_URL=http://localhost:6333

# ---------- 服务行为 ----------
CORS_ALLOW_ORIGINS=["*"]
REQUEST_TIMEOUT=30.0
LLM_RETRY_ATTEMPTS=3
